PREFIX powla: <http://purl.org/powla/powla.owl#>
PREFIX lila_corpus: <http://lila-erc.eu/ontologies/lila_corpora/>
PREFIX lilaOntology: <http://lila-erc.eu/ontologies/lila/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?document ?title ?tm (COUNT(?token) AS ?tokens) (COUNT(?lemma) AS ?linked)
       (ROUND(100 * COUNT(?lemma) / COUNT(?token)) AS ?percentLinked)
WHERE {
  ?document a powla:Document ;
            dc:title ?title ;
            dcterms:identifier ?tm .
  ?structure powla:hasDocument ?document ;
             a lila_corpus:CitationStructure .
  FILTER(STRENDS(STR(?structure), "/CiteStructure"))
  ?token lila_corpus:hasCitStructure ?structure .
  OPTIONAL { ?token lilaOntology:hasLemma ?lemma }
}
GROUP BY ?document ?title ?tm
ORDER BY DESC(?tokens)
LIMIT 20
