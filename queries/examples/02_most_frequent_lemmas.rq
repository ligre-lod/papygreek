PREFIX powla: <http://purl.org/powla/powla.owl#>
PREFIX lila_corpus: <http://lila-erc.eu/ontologies/lila_corpora/>
PREFIX lilaOntology: <http://lila-erc.eu/ontologies/lila/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?lemma ?writtenRep ?tokens
WHERE {
  {
    SELECT ?lemma (COUNT(?token) AS ?tokens)
    WHERE { ?token a powla:Terminal ; lilaOntology:hasLemma ?lemma }
    GROUP BY ?lemma
  }
  OPTIONAL { ?lemma rdfs:label ?writtenRep }
}
ORDER BY DESC(?tokens)
LIMIT 20
